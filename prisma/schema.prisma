generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Equipe {
  id               Int           @id @default(autoincrement())
  nome             String        @unique
  thresholdAmarelo Int           @default(3)
  thresholdVerde   Int           @default(4)
  colaboradores    Colaborador[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Colaborador {
  id             Int                    @id @default(autoincrement())
  nome           String
  cargo          String?
  matricula      String?                @unique
  ativo          Boolean                @default(true)
  equipeId       Int
  equipe         Equipe                 @relation(fields: [equipeId], references: [id])
  escalas        EscalaSemana[]
  pontos         RegistroPonto[]
  folgas         Folga[]
  plantoes       Plantao[]
  bancoHoras          LancamentoBancoHoras[]
  escalaPlantao       EscalaPlantaoMensal[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model EscalaSemana {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  semana        DateTime
  tipo          TipoEscala
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, semana])
}

enum TipoEscala {
  PRESENCIAL
  REMOTO
}

model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  entrada       DateTime?
  saida         DateTime?
  horasExtras   Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([colaboradorId, data])
}

model Folga {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          TipoFolga
  descricao     String?
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, data])
}

enum TipoFolga {
  SABADO
  DOMINGO
  FERIADO
}

model Plantao {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          TipoFolga
  folga1        DateTime?   @db.Date
  folga2        DateTime?   @db.Date
  descricao     String?
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, data])
}

model EscalaPlantaoMensal {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          TipoFolga
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, data])
}

model LancamentoBancoHoras {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  horas         Float
  descricao     String?
  createdAt     DateTime    @default(now())
}

model FeriadoCustomizado {
  id        Int      @id @default(autoincrement())
  data      DateTime @db.Date
  descricao String
  createdAt DateTime @default(now())

  @@unique([data])
}
