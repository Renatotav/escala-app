generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Equipe {
  id               Int           @id @default(autoincrement())
  nome             String        @unique
  thresholdAmarelo Int           @default(3)
  thresholdVerde   Int           @default(4)
  colaboradores    Colaborador[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Colaborador {
  id              Int                    @id @default(autoincrement())
  nome            String
  cargo           String?
  matricula       String?                @unique
  ativo           Boolean                @default(true)
  equipeId        Int
  equipe          Equipe                 @relation(fields: [equipeId], references: [id])
  dataNascimento  DateTime?              @db.Date
  cpf             String?
  email           String?
  telefone        String?
  telefoneEmerg   String?
  nomeEmerg       String?
  endereco        String?
  escalas         EscalaSemana[]
  pontos          RegistroPonto[]
  folgas          Folga[]
  plantoes        Plantao[]
  bancoHoras      LancamentoBancoHoras[]
  escalaPlantao   EscalaPlantaoMensal[]
  atestados         Atestado[]
  declaracoes       DeclaracaoMedica[]
  feedbacks         Feedback[]
  ocorrencias       Ocorrencia[]
  controleTriagem   ControleTriagem[]
  grupoListagem              String                 @default("FORA")
  ajusteSemanasPresencial    Int                    @default(0)
  semRemoto                  Boolean                @default(false)
  tokenAtendimento           String?                @unique
  ultimoAcessoAtendimento    DateTime?
  acessosAtendimento         Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model Feedback {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  descricao     String
  assinatura    String?
  createdAt     DateTime    @default(now())
}

model Ocorrencia {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          String?
  descricao     String
  assinatura    String?
  createdAt     DateTime    @default(now())
}

model EscalaSemana {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  semana        DateTime
  tipo          TipoEscala
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, semana])
}

enum TipoEscala {
  PRESENCIAL
  REMOTO
}

model RegistroPonto {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  entrada       DateTime?
  saida         DateTime?
  horasExtras   Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([colaboradorId, data])
}

model Folga {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          TipoFolga
  descricao     String?
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, data])
}

enum TipoFolga {
  SABADO
  DOMINGO
  FERIADO
  PONTO_FACULTATIVO
}

model Plantao {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          TipoFolga
  folga1        DateTime?   @db.Date
  folga2        DateTime?   @db.Date
  descricao     String?
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, data])
}

model EscalaPlantaoMensal {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  tipo          TipoFolga
  createdAt     DateTime    @default(now())

  @@unique([colaboradorId, data])
}

model Atestado {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  dataInicio    DateTime    @db.Date
  dataFim       DateTime    @db.Date
  cid           String?
  descricao     String?
  createdAt     DateTime    @default(now())
}

model DeclaracaoMedica {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  horaEntrada   String?
  horaSaida     String?
  especialidade String?
  observacao    String?
  createdAt     DateTime    @default(now())
}

model ControleTriagem {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  motivo        String
  dataInicio    DateTime
  horaInicio    String?
  dataFim       DateTime?
  horaFim       String?
  observacao    String?
  atestadoId    Int?
  createdAt     DateTime    @default(now())
}

model LancamentoBancoHoras {
  id            Int         @id @default(autoincrement())
  colaboradorId Int
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  data          DateTime    @db.Date
  horas         Float
  descricao     String?
  createdAt     DateTime    @default(now())
}

model FeriadoCustomizado {
  id        Int      @id @default(autoincrement())
  data      DateTime @db.Date
  descricao String
  createdAt DateTime @default(now())

  @@unique([data])
}

model Chamado {
  id                   Int       @id @default(autoincrement())
  referencia           String
  alerta               String?
  nivelEscalacao       Int?
  estado               String?
  dataRegistro         DateTime?
  nomeAfetado          String?
  nomeSecao            String?
  nomeItem             String?
  nomeCategoria        String?
  nomeDpsAtribuido     String?
  nomeUsuarioAtribuido String?
  ultimaAcao           String?
  createdAt            DateTime  @default(now())
}
